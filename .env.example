# Copy to .env  (git-ignored).  npm start reads it via node --env-file-if-exists.

# Seed for the three permanent campaign tokens. They are DERIVED from this, which
# is why the same URLs survive restarts and wiped disks. Set it once, before any
# campaign goes out: changing it changes all three URLs and kills links already
# sent. Left unset, a default in the code is used - fine for testing, but anyone
# who can read the source can compute the tokens.
#CAMPAIGN_SECRET=
#
# simulate            - no network call, console only (default)
# enterprise_text     - msg_type=TEXT via media.smsgupshup.com. Free-form, so it
#                       only works inside the 24h customer-care window. No
#                       template needed. Start here.
# enterprise_template - msg_type=HSM. Needs an approved template.
GUPSHUP_MODE=simulate

# Gupshup Enterprise credentials (the smsgupshup.com dashboard login).
GUPSHUP_USERID=
GUPSHUP_PASSWORD=

# Override only if your account uses a different gateway host.
#GUPSHUP_BASE=https://media.smsgupshup.com/GatewayAPI/rest

# Enterprise accounts vary in the params they demand. Anything here is merged
# into the request, so you can adjust without touching code.
#GUPSHUP_EXTRA_PARAMS=data_encoding=text&override_dnd=true

# POST (default) or GET. Enterprise docs mostly show GET; if you get error 106
# "method not supported" with valid credentials, try GET.
#GUPSHUP_HTTP_METHOD=GET

# Per-intent template ids, used only by enterprise_template.
#GUPSHUP_TEMPLATE_LISTING_DRAFT=
#GUPSHUP_TEMPLATE_PICKUP_SLOT=
#GUPSHUP_TEMPLATE_BID_RESPONSE=
#GUPSHUP_TEMPLATE_KYC=
