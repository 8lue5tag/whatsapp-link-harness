# Copy to .env (git-ignored). npm start reads it via node --env-file-if-exists.
# On Render these go in the service's Environment tab instead.

# ---------------------------------------------------------------- campaign ----
# Seed for the three permanent campaign tokens. They are DERIVED from this, which
# is why the same URLs survive restarts and wiped disks. Set it once, before any
# campaign goes out: changing it changes all three URLs and kills links already
# sent. Left unset, a default in the code is used - fine for testing, but anyone
# who can read the source can compute the tokens.
#CAMPAIGN_SECRET=

# ---------------------------------------------------------------- defaults ----
# Only the fallback when the console doesn't say otherwise. Provider, mode and
# template are normally chosen per send in the console's Send settings panel.
#   simulate | gupshup | wati | msg91
SEND_PROVIDER=simulate
#   text     - free-form, needs the 24h customer-care window, any URL, no approval
#   template - approved template, sends only the token into the frozen URL base
SEND_MODE=text

# --------------------------------------------------------------- 1. gupshup ---
# enterprise (media.smsgupshup.com, userid/password) is auto-assumed unless an
# API key is present. Force it either way with GUPSHUP_FLAVOUR.
#GUPSHUP_FLAVOUR=enterprise
GUPSHUP_USERID=
GUPSHUP_PASSWORD=
# Self-serve (api.gupshup.io) instead:
#GUPSHUP_API_KEY=
#GUPSHUP_SOURCE=
#GUPSHUP_APP_NAME=
# Enterprise accounts vary in the params they demand; merged into the request.
#GUPSHUP_EXTRA_PARAMS=data_encoding=text&override_dnd=true
# If you get error 106 "method not supported" with valid credentials, try GET.
#GUPSHUP_HTTP_METHOD=GET

# ------------------------------------------------------------------ 2. wati ---
# Per-tenant base URL - copy it from WATI's own API docs page, don't guess:
#   https://live-mt-server.wati.io/123456   or   https://live-server-123456.wati.io
WATI_BASE_URL=
WATI_TOKEN=
# WATI template variables are NAMED. This must match whatever you called the
# dynamic URL button's variable when you built the template.
#WATI_BUTTON_PARAM=token
#WATI_BROADCAST_NAME=harness-test

# ----------------------------------------------------------------- 3. msg91 ---
MSG91_AUTHKEY=
MSG91_INTEGRATED_NUMBER=
#MSG91_TEMPLATE_LANG=en

# ------------------------------------------------------------ template names ---
# Optional per-intent defaults, used when the console's template field is blank.
#TEMPLATE_SELLER_PORTAL=
#TEMPLATE_LISTING_DRAFT=
#TEMPLATE_BID_RESPONSE=
#TEMPLATE_KYC=
