{
  "name": "whatsapp-link-token-harness",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Local harness for testing WhatsApp CTA link tokens, scoped sessions and step-up auth",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "reset": "node -e \"require('fs').rmSync('data/db.json',{force:true});console.log('db reset')\"",
    "wati:check": "node --env-file-if-exists=.env scripts/wati-check.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
